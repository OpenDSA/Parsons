    "blocks": [
      {
        "text": "To prove that a problem X is NP-complete do this:",
        "type": "",
        "tag": "starter",
        "depends": "",
        "indent": true,
        "displaymath": true,
        "feedback": ""
      },
      {
        "text": "Show that X is in NP.",
        "tag": "inNP-xinNP",
        "type": "",
        "depends": null,
        "displaymath": true,
        "feedback": null,
        "reusable": false
      },
      {
        "text": "Create an algorithm to solve X (that might or might not use non-determinism) that runs in polynomial time.",
        "tag": "inNP-algorithm",
        "type": "",
        "depends": "inNP-xinNP",
        "displaymath": true,
        "feedback": null,
        "reusable": false
      },
      {
        "text": "Show that X is NP-hard.",
        "tag": "NPhard-starthard",
        "type": "",
        "depends": null,
        "displaymath": true,
        "feedback": null,
        "reusable": false
      },
      {
        "text": "Choose a known NP-hard problem A.",
        "tag": "NPhard-choose",
        "type": "",
        "depends": "NPhard-starthard",
        "displaymath": true,
        "feedback": null,
        "reusable": false
      },
      {
        "text": "Define two transformations.",
        "tag": "NPhard-transfo",
        "type": "",
        "depends": "NPhard-choose",
        "displaymath": true,
        "feedback": null,
        "reusable": false
      },
      {
        "text": "Describe a polynomial-time algorithm that takes an arbitrary instance $\\textbf{I}$ of <code>A`X</code> to an instance $\\textbf{I′}$ of <code>X`A</code>.",
        "tag": "NPhard-t1",
        "type": "",
        "depends": "NPhard-transfo",
        "displaymath": true,
        "feedback": null,
        "reusable": false
      },
      {
        "text": "Describe a polynomial-time transformation from the solution for $\\textbf{I’}$ in problem <code>X`A</code> (call it $\\textbf{SLN’}$) to $\\textbf{SLN}$ such that $\\textbf{SLN}$ is the solution for $\\textbf{I}$ in problem <code>A`X</code>.",
